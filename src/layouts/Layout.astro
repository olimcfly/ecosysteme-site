---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Écosystème Immo — Système d'acquisition local pour conseillers immobiliers",
  description = 'Site professionnel, SEO local, CRM et automatisations IA sur votre territoire exclusif. Un seul conseiller par ville.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Écosystème Immo",
      "description": "Système d'acquisition local pour conseillers immobiliers indépendants",
      "url": "https://ecosystemeimmo.fr",
      "telephone": "07 85 61 17 00",
      "email": "contact@ecosystemeimmo.fr",
      "founder": { "@type": "Person", "name": "Olivier Colas" }
    })} />
  </head>
  <body class="font-sans bg-white">
    <!-- Scarcity bar -->
    <div id="scarcity-bar" class="bg-navy-900 text-white text-center py-2.5 px-4 text-xs sm:text-sm font-medium z-50 sticky top-0">
      <span class="text-slate-300">Territoires complets :</span>
      <span class="mx-1 text-white font-semibold">Bordeaux · Nantes · Nandy · Aix-en-Provence · Lannion</span>
      <span class="hidden sm:inline text-slate-300">—</span>
      <a href="#verifier" class="ml-2 underline underline-offset-2 text-slate-200 hover:text-white transition-colors">
        Vérifiez votre ville &rarr;
      </a>
    </div>

    <slot />
  </body>
</html>

