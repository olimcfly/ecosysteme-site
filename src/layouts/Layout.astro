---
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Système d'acquisition local pour conseillers immobiliers indépendants. Exclusif à votre territoire.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={Astro.url.href} />
  <title>{title} — Écosystème Immo</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Barre de scarcité — sticky, z-index 100 — NE PAS SUPPRIMER -->
  <div id="scarcity-bar">
    <span class="bar-text">Territoires complets&nbsp;: Bordeaux · Nantes · Nandy · Aix-en-Provence · Lannion</span>
    <span class="bar-sep">&nbsp;—&nbsp;</span>
    <a href="#verifier" class="bar-link">Vérifiez votre ville →</a>
  </div>
  <slot />
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --navy: #0f172a;
    --navy-mid: #1e293b;
    --off-white: #f8fafc;
    --muted: #e2e8f0;
    --subtle: #f1f5f9;
    --text: #334155;
    --text-light: #64748b;
    --text-xlight: #94a3b8;
    --badge-red: #dc2626;
    --radius: 8px;
    --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font);
    background: #fff;
    color: var(--navy);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a { color: inherit; }
  img { max-width: 100%; display: block; }

  /* Barre de scarcité */
  #scarcity-bar {
    background: var(--navy);
    color: var(--off-white);
    text-align: center;
    padding: 10px 20px;
    font-size: 13px;
    letter-spacing: 0.01em;
    position: sticky;
    top: 0;
    z-index: 100;
    line-height: 1.4;
  }

  .bar-link {
    color: var(--muted);
    text-decoration: underline;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .bar-sep { display: none; }
    .bar-text { display: block; margin-bottom: 4px; }
    #scarcity-bar { font-size: 12px; padding: 10px 16px; }
  }
</style>
