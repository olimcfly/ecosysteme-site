---
import Layout from '../layouts/Layout.astro';
import CTAFinal from '../components/CTAFinal.astro';
---

<Layout
  title="Blog — Écosystème Immo"
  description="Articles et ressources pour les conseillers immobiliers indépendants qui veulent dominer leur territoire local."
>
  <div class="bg-slate-950 text-white py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl font-bold tracking-tight mb-4">Blog</h1>
      <p class="text-lg text-slate-300">
        Articles et ressources pour les conseillers immobiliers indépendants.
      </p>
    </div>
  </div>

  <div class="py-24 px-4 text-center">
    <p class="text-slate-400 text-sm">Les premiers articles arrivent bientôt.</p>
  </div>

  <CTAFinal />
</Layout>
