---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import Realisations from '../components/Realisations.astro';
import FAQ from '../components/FAQ.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Écosystème Immo — Système d'acquisition local pour conseillers immobiliers"
  description="Site professionnel, SEO local, CRM et automatisations IA sur votre territoire exclusif. Un seul conseiller par ville. Vérifiez la disponibilité de votre ville."
>
  <Header />
  <main>
    <Hero />
    <HowItWorks />
    <Features />
    <Pricing />
    <Realisations />
    <FAQ />
    <CtaFinal />
  </main>
  <Footer />
</Layout>
