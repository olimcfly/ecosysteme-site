---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Realisations from '../components/Realisations.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import VerifyForm from '../components/VerifyForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Écosystème Immo — Système d'acquisition local pour conseillers immobiliers"
  description="Un seul conseiller par ville. Site professionnel, SEO local, CRM et automatisations IA — installés sur votre territoire exclusif en 21 jours."
>
  <Header />
  <main>
    <Hero />
    <HowItWorks />
    <Features />
    <Realisations />
    <Pricing />
    <FAQ />
    <VerifyForm />
  </main>
  <Footer />
</Layout>
