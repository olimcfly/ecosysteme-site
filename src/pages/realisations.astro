---
import Layout from '../layouts/Layout.astro';
import CTAFinal from '../components/CTAFinal.astro';

const clients = [
  {
    city: 'Bordeaux Métropole',
    name: 'Eduardo De Sul',
    description:
      'Livré en 18 jours : site local, 6 pages secteurs, estimateur intégré, 3 articles SEO de démarrage, séquence email vendeurs.',
    detail:
      "Eduardo dispose d'une présence propriétaire sur Bordeaux — indépendante de son réseau.",
  },
  {
    city: 'Aix-en-Provence',
    name: 'Pascal Hamm',
    description:
      'Site brandé, pages services, estimateur, structure SEO locale.',
    detail:
      'Fondation digitale posée sur un marché à forte concurrence.',
  },
  {
    city: 'Nandy / Sénart',
    name: 'Fatima Rabia',
    description:
      'Site local humanisé, formulaire vendeur, pages secteurs.',
    detail:
      "Présence propriétaire sur son territoire d'origine.",
  },
  {
    city: 'Lannion / Trégor',
    name: 'Stéphanie Hulen',
    description:
      'Site local, pages géographiques, contenus et formulaires.',
    detail:
      "Présence digitale ancrée dans l'identité bretonne de son territoire.",
  },
  {
    city: 'Nantes',
    name: 'Brice Chupin',
    description:
      'Positionnement "coach immobilier" rendu visible localement.',
    detail:
      'Présence différenciante sur Nantes.',
  },
];
---

<Layout
  title="Réalisations — Écosystème Immo"
  description="Les territoires déjà installés. Cinq conseillers indépendants avec un système d'acquisition local exclusif."
>
  <div class="bg-slate-950 text-white py-20 md:py-28 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
        Les territoires déjà installés
      </h1>
      <p class="text-lg text-slate-300 mt-4">
        Cinq bases locales construites pour des conseillers indépendants.
        Ces territoires sont désormais fermés.
      </p>
    </div>
  </div>

  <section class="py-20 md:py-28 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {clients.map(client => (
          <div class="relative bg-white border border-slate-200 rounded-xl p-8">
            <div class="flex items-start justify-between mb-4 gap-4">
              <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">
                  {client.city}
                </p>
                <h2 class="text-xl font-bold text-slate-900">{client.name}</h2>
              </div>
              <span class="shrink-0 inline-flex items-center px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wide bg-red-600 text-white">
                Territoire complet
              </span>
            </div>
            <p class="text-slate-700 mb-2 leading-relaxed">{client.description}</p>
            <p class="text-sm text-slate-500">{client.detail}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 text-center">
        <p class="text-lg text-slate-600 mb-6">
          Ces territoires sont fermés. Le vôtre est peut-être encore disponible.
        </p>
        <a
          href="#verifier"
          class="inline-flex items-center px-7 py-3.5 bg-blue-700 text-white font-semibold rounded-lg hover:bg-blue-800 transition-colors"
        >
          Vérifier ma ville
        </a>
      </div>
    </div>
  </section>

  <CTAFinal />
</Layout>
