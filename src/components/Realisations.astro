---
const territories = [
  {
    city: "Bordeaux Métropole",
    advisor: "Eduardo De Sul",
    description:
      "Livré en 18 jours : site local, 6 pages secteurs, estimateur intégré, 3 articles SEO de démarrage, séquence email vendeurs. Présence propriétaire sur Bordeaux, indépendante de son réseau.",
  },
  {
    city: "Aix-en-Provence",
    advisor: "Pascal Hamm",
    description:
      "Site brandé, pages services, estimateur, structure SEO locale. Fondation digitale posée sur un marché à forte concurrence.",
  },
  {
    city: "Nandy / Sénart",
    advisor: "Fatima Rabia",
    description:
      "Site local humanisé, formulaire vendeur, pages secteurs. Présence propriétaire sur son territoire d'origine.",
  },
  {
    city: "Lannion / Trégor",
    advisor: "Stéphanie Hulen",
    description:
      "Site local, pages géographiques, contenus et formulaires. Présence digitale ancrée dans l'identité bretonne de son territoire.",
  },
  {
    city: "Nantes",
    advisor: "Brice Chupin",
    description:
      "Positionnement « coach immobilier » rendu visible localement. Présence différenciante sur Nantes.",
  },
];
---
<section class="realisations" id="realisations">
  <div class="container">
    <div class="intro">
      <h2>Les territoires déjà installés</h2>
      <p>Cinq bases locales construites pour des conseillers indépendants.<br class="br-d">Ces territoires sont désormais fermés.</p>
    </div>
    <div class="grid">
      {territories.map(t => (
        <div class="card">
          <div class="badge-territory">TERRITOIRE COMPLET</div>
          <h3>{t.city}</h3>
          <p class="advisor">{t.advisor}</p>
          <p class="description">{t.description}</p>
        </div>
      ))}
    </div>
    <div class="cta-section">
      <p>Ces territoires sont fermés. Le vôtre est peut-être encore disponible.</p>
      <a href="#verifier" class="btn-primary">Vérifier ma ville</a>
    </div>
  </div>
</section>

<style>
  .realisations {
    background: #fff;
    padding: 96px 16px;
    border-top: 1px solid #e2e8f0;
  }

  .container { max-width: 1100px; margin: 0 auto; }

  .intro {
    text-align: center;
    margin-bottom: 56px;
  }

  h2 {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .intro p {
    font-size: 16px;
    color: #475569;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 56px;
  }

  .card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 28px 24px;
  }

  .badge-territory {
    display: inline-block;
    background: #dc2626;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 16px;
  }

  h3 {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 4px;
    line-height: 1.25;
  }

  .advisor {
    font-size: 14px;
    color: #64748b;
    font-weight: 500;
    margin-bottom: 14px;
  }

  .description {
    font-size: 14px;
    color: #475569;
    line-height: 1.65;
  }

  .cta-section {
    text-align: center;
  }

  .cta-section p {
    font-size: 16px;
    color: #334155;
    margin-bottom: 20px;
  }

  .btn-primary {
    display: inline-block;
    background: #0f172a;
    color: #f8fafc;
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .btn-primary:hover { opacity: 0.85; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .br-d { display: none; }
  }

  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .realisations { padding: 72px 16px; }
  }
</style>
