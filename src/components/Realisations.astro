---
const clients = [
  {
    city: 'Bordeaux Métropole',
    name: 'Eduardo De Sul',
    desc: "Livré en 18 jours : site local, 6 pages secteurs, estimateur intégré, 3 articles SEO de démarrage, séquence email vendeurs.",
    note: "Présence propriétaire sur Bordeaux — indépendante de son réseau.",
  },
  {
    city: 'Aix-en-Provence',
    name: 'Pascal Hamm',
    desc: "Site brandé, pages services, estimateur, structure SEO locale. Fondation digitale posée sur un marché à forte concurrence.",
  },
  {
    city: 'Nandy / Sénart',
    name: 'Fatima Rabia',
    desc: "Site local humanisé, formulaire vendeur, pages secteurs. Présence propriétaire sur son territoire d'origine.",
  },
  {
    city: 'Lannion / Trégor',
    name: 'Stéphanie Hulen',
    desc: "Site local, pages géographiques, contenus et formulaires. Présence digitale ancrée dans l'identité bretonne de son territoire.",
  },
  {
    city: 'Nantes',
    name: 'Brice Chupin',
    desc: "Positionnement coach immobilier rendu visible localement. Présence différenciante sur Nantes.",
  },
];
---
<section class="section realisations-section">
  <div class="container">
    <span class="section-label">Réalisations</span>
    <h2 class="section-heading">Les territoires déjà installés</h2>
    <p class="section-sub" style="margin-bottom: 40px;">
      Cinq bases locales construites pour des conseillers indépendants.
      Ces territoires sont désormais fermés.
    </p>

    <div class="grid">
      {clients.map(c => (
        <div class="card">
          <div class="complet">TERRITOIRE COMPLET</div>
          <h3>{c.city}</h3>
          <p class="name">{c.name}</p>
          <p class="desc">{c.desc}</p>
          {c.note && <p class="note">{c.note}</p>}
        </div>
      ))}
    </div>

    <div class="cta-block">
      <p>Ces territoires sont fermés. Le vôtre est peut-être encore disponible.</p>
      <a href="#verifier" class="btn btn-primary">Vérifier ma ville</a>
    </div>
  </div>
</section>

<style>
  .realisations-section { background: var(--c-white); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  .card {
    border: 1px solid var(--c-border);
    border-radius: var(--c-radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .complet {
    display: inline-block;
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--c-red);
    color: white;
    padding: 3px 8px;
    border-radius: 3px;
  }

  .card h3 { font-size: 16px; }

  .name {
    font-size: 13px;
    color: var(--c-muted);
    font-weight: 500;
  }

  .desc {
    font-size: 13px;
    color: var(--c-muted);
    line-height: 1.6;
  }

  .note {
    font-size: 12px;
    color: var(--c-muted);
    font-style: italic;
  }

  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .cta-block p { font-size: 16px; color: var(--c-dark-2); }

  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px)  { .grid { grid-template-columns: 1fr; } }
</style>
