---
const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/#process", label: "Comment ça marche" },
  { href: "/offre", label: "Offres" },
  { href: "/realisations", label: "Réalisations" },
  { href: "/blog", label: "Blog" },
];
---
<header>
  <nav>
    <a href="/" class="logo" aria-label="Écosystème Immo — Accueil">
      Écosystème Immo
    </a>
    <button class="menu-toggle" id="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul id="nav-links" role="list">
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <a href="#verifier" class="cta-nav">Vérifier ma ville</a>
  </nav>
</header>

<style>
  header {
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 40px;
    z-index: 90;
  }

  nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .logo {
    font-weight: 700;
    font-size: 15px;
    color: #0f172a;
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
    flex-shrink: 0;
  }

  ul {
    display: flex;
    list-style: none;
    gap: 24px;
    margin-right: 24px;
  }

  ul a {
    font-size: 14px;
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s;
  }

  ul a:hover { color: #0f172a; }

  .cta-nav {
    background: #0f172a;
    color: #f8fafc;
    padding: 9px 18px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }

  .cta-nav:hover { opacity: 0.85; }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    padding: 4px 0;
    margin-left: auto;
    margin-right: 16px;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #0f172a;
    border-radius: 2px;
    transition: all 0.2s;
  }

  @media (max-width: 820px) {
    .menu-toggle { display: flex; }

    ul {
      display: none;
      flex-direction: column;
      position: absolute;
      left: 0;
      right: 0;
      top: 64px;
      background: #fff;
      padding: 12px 16px 20px;
      border-bottom: 1px solid #e2e8f0;
      gap: 0;
      margin-right: 0;
      box-shadow: 0 8px 24px rgba(15,23,42,0.08);
    }

    ul.is-open { display: flex; }

    ul li a {
      display: block;
      padding: 12px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 15px;
    }

    .cta-nav {
      display: none;
    }

    nav { position: relative; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const navLinks = document.getElementById('nav-links');
  if (toggle && navLinks) {
    toggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !navLinks.contains(e.target as Node)) {
        navLinks.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
