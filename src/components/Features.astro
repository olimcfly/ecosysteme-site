---
const features = [
  {
    number: '01',
    title: 'Site immobilier local',
    body: "Professionnel, mobile-first, brandé à votre nom. Pensé pour capter les propriétaires vendeurs de votre secteur.",
  },
  {
    number: '02',
    title: 'Pages secteurs et quartiers',
    body: "Des pages dédiées à vos communes et zones d'influence, optimisées pour apparaître sur Google quand un vendeur cherche dans votre ville.",
  },
  {
    number: '03',
    title: 'Google Business Profile',
    body: "Une fiche locale cohérente avec votre site. Indispensable pour apparaître sur Google Maps et dans les résultats locaux.",
  },
  {
    number: '04',
    title: 'Formulaire vendeur',
    body: "Un point d'entrée clair pour capter les demandes d'estimation et les contacts vendeurs directement depuis votre site.",
  },
  {
    number: '05',
    title: 'CRM et suivi prospects',
    body: "Suivi centralisé de vos contacts, statuts et prochaines actions. Tout au même endroit, sans outils dispersés.",
  },
  {
    number: '06',
    title: 'Automatisations et IA',
    body: "Rappels automatiques, relances intelligentes, scoring prospects. Le système travaille quand vous prospectez.",
  },
];
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Le système</p>
      <h2>Un système d'acquisition local, pas un outil de plus.</h2>
      <p>
        Visibilité locale, contenus SEO, capture vendeurs, suivi CRM et automatisations IA
        — activé sur votre territoire exclusif.
      </p>
    </div>

    <div class="features-grid">
      {features.map(feature => (
        <div class="feature-card">
          <div class="feature-number" aria-hidden="true">{feature.number}</div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-body">{feature.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 1.75rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .feature-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .feature-number {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .feature-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 0.625rem;
    line-height: 1.3;
  }

  .feature-body {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .feature-card {
      padding: 1.375rem;
    }
  }
</style>
