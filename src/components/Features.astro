---
const features = [
  {
    num: '01',
    title: 'Site immobilier local',
    desc: "Professionnel, mobile-first, brandé à votre nom. Pensé pour capter les propriétaires vendeurs de votre secteur.",
  },
  {
    num: '02',
    title: 'Pages secteurs et quartiers',
    desc: "Des pages dédiées à vos communes et zones d'influence, optimisées pour apparaître sur Google quand un vendeur cherche dans votre ville.",
  },
  {
    num: '03',
    title: 'Google Business Profile',
    desc: "Une fiche locale cohérente avec votre site. Indispensable pour apparaître sur Google Maps et dans les résultats locaux.",
  },
  {
    num: '04',
    title: 'Formulaire vendeur',
    desc: "Un point d'entrée clair pour capter les demandes d'estimation et les contacts vendeurs directement depuis votre site.",
  },
  {
    num: '05',
    title: 'CRM et suivi prospects',
    desc: "Suivi centralisé de vos contacts, statuts et prochaines actions. Tout au même endroit, sans outils dispersés.",
  },
  {
    num: '06',
    title: 'Automatisations et IA',
    desc: "Rappels automatiques, relances intelligentes, scoring prospects. Le système travaille quand vous prospectez.",
  },
];
---
<section class="section features-section">
  <div class="container">
    <span class="section-label">Ce qui est inclus</span>
    <h2 class="section-heading">Un système d'acquisition local, pas un outil de plus.</h2>
    <p class="section-sub" style="margin-bottom: 48px;">
      Visibilité locale, contenus SEO, capture vendeurs, suivi CRM et automatisations IA
      — activé sur votre territoire exclusif.
    </p>

    <div class="grid">
      {features.map(f => (
        <div class="card">
          <div class="num">{f.num}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section { background: var(--c-white); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: calc(var(--c-radius) + 1px);
    overflow: hidden;
  }

  .card {
    background: var(--c-white);
    padding: 28px 28px 32px;
  }

  .num {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-blue);
    margin-bottom: 12px;
  }

  .card h3 { font-size: 15px; font-weight: 600; margin-bottom: 8px; }

  .card p { font-size: 14px; color: var(--c-muted); line-height: 1.6; }

  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .grid { grid-template-columns: 1fr; } .card { padding: 22px; } }
</style>
