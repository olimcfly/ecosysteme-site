---
interface Props {
  title?: string;
  subtitle?: string;
  showSecondaryCta?: boolean;
}

const {
  title = "Votre ville a une seule place disponible.",
  subtitle = "Écosystème Immo installe votre système d'acquisition local — site professionnel, SEO, Google Business, pages quartiers, CRM et automatisations IA. Exclusif à votre territoire. Un seul conseiller par ville.",
  showSecondaryCta = true,
} = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Système d'acquisition local</p>
        <h1 class="hero-title">{title}</h1>
        <p class="hero-subtitle">{subtitle}</p>

        <div class="hero-cta-group">
          <a href="#verifier" class="btn btn-primary btn-lg">
            Vérifier si ma ville est disponible
          </a>
          {showSecondaryCta && (
            <a href="#process" class="btn btn-outline btn-lg">
              Comment ça marche
            </a>
          )}
        </div>

        <p class="hero-reassurance">
          Sans engagement &middot; Réponse sous 24h &middot; Un seul conseiller par ville
        </p>
      </div>

      <div class="hero-aside" aria-hidden="true">
        <div class="hero-stat-card">
          <p class="stat-label">Territoires fermés</p>
          <p class="stat-number">6</p>
          <p class="stat-detail">Bordeaux, Nantes, Nandy,<br />Aix, Lannion, Angers</p>
        </div>
        <div class="hero-stat-card">
          <p class="stat-label">Livraison clé en main</p>
          <p class="stat-number">21j</p>
          <p class="stat-detail">Site + SEO + CRM + IA<br />opérationnels</p>
        </div>
        <div class="hero-stat-card">
          <p class="stat-label">Premiers contacts vendeurs</p>
          <p class="stat-number">60–90j</p>
          <p class="stat-detail">Observé sur les territoires<br />déjà installés</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 5rem 0 4rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    max-width: 620px;
  }

  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--dark);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 2.25rem;
    max-width: 540px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .hero-reassurance {
    font-size: 0.8125rem;
    color: var(--subtle);
    font-weight: 500;
  }

  /* Aside stats */
  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-stat-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--subtle);
    margin-bottom: 0.375rem;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 0.375rem;
    letter-spacing: -0.03em;
  }

  .stat-detail {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-aside {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .hero-stat-card {
      flex: 1 1 calc(50% - 0.5rem);
      min-width: 200px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3.5rem 0 3rem;
    }

    .hero-cta-group {
      flex-direction: column;
    }

    .hero-cta-group .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-aside {
      flex-direction: column;
    }

    .hero-stat-card {
      flex: 1;
    }
  }
</style>
