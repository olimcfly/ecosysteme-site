<footer>
  <div class="container">
    <div class="top">
      <div class="brand">
        <strong>Écosystème Immo</strong>
        <span>Système d'acquisition local pour conseillers immobiliers indépendants.</span>
      </div>
      <nav class="footer-nav" aria-label="Navigation secondaire">
        <a href="/offre">Offres</a>
        <a href="/realisations">Réalisations</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
      </nav>
      <address class="contact">
        <p>Olivier Colas</p>
        <p><a href="tel:+33785611700">07 85 61 17 00</a></p>
        <p><a href="mailto:contact@ecosystemeimmo.fr">contact@ecosystemeimmo.fr</a></p>
      </address>
    </div>
    <div class="bottom">
      <nav class="legal" aria-label="Liens légaux">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/cgu">CGU</a>
