<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="logo">Écosystème Immo</p>
        <p class="tagline">Système d'acquisition local pour conseillers immobiliers indépendants.</p>
        <address>
          Olivier Colas<br>
          <a href="tel:0785611700">07 85 61 17 00</a><br>
          <a href="mailto:contact@ecosystemeimmo.fr">contact@ecosystemeimmo.fr</a>
        </address>
      </div>

      <nav aria-label="Pied de page">
        <a href="/tarifs">Offres</a>
        <a href="/realisations">Réalisations</a>
        <a href="/comment-ca-marche">Comment ça marche</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© 2026 Écosystème Immo — OCDM Agency</p>
      <div class="legal">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/cgu">CGU</a>
        <a href="/confidentialite">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--c-dark);
    padding: 56px 0 28px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .logo {
    font-size: 16px;
    font-weight: 700;
    color: var(--c-white);
    margin-bottom: 8px;
  }

  .tagline {
    font-size: 13px;
    color: #64748b;
    max-width: 280px;
    line-height: 1.6;
    margin-bottom: 18px;
  }

  address {
    font-style: normal;
    font-size: 13px;
    color: #64748b;
    line-height: 1.9;
  }
  address a { color: #94a3b8; text-decoration: none; transition: color 0.15s; }
  address a:hover { color: var(--c-white); }

  nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  nav a {
    font-size: 14px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s;
  }
  nav a:hover { color: #94a3b8; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid #1e293b;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-bottom p { font-size: 12px; color: #475569; }

  .legal { display: flex; gap: 16px; }
  .legal a { font-size: 12px; color: #475569; text-decoration: none; transition: color 0.15s; }
  .legal a:hover { color: #64748b; }

  @media (max-width: 640px) {
    .footer-top  { flex-direction: column; gap: 28px; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
