---
---
<footer class="bg-white border-t border-slate-100 py-12 px-4">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-8">

      <!-- Brand -->
      <div class="max-w-xs">
        <p class="font-bold text-navy-900 text-base mb-1">Écosystème Immo</p>
        <p class="text-sm text-slate-500 leading-relaxed">
          Système d'acquisition local pour conseillers immobiliers indépendants.
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-col sm:flex-row gap-6 sm:gap-12">
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Liens</p>
          <div class="flex flex-col gap-2">
            {[
              { label: 'Offres', href: '/offre' },
              { label: 'Réalisations', href: '#realisations' },
              { label: 'Blog', href: '/blog' },
              { label: 'Contact', href: 'mailto:contact@ecosystemeimmo.fr' },
            ].map(l => (
              <a href={l.href} class="text-sm text-slate-600 hover:text-navy-900 transition-colors">{l.label}</a>
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Contact</p>
          <div class="flex flex-col gap-2 text-sm text-slate-600">
            <span>Olivier Colas</span>
            <a href="tel:0785611700" class="hover:text-navy-900 transition-colors">07 85 61 17 00</a>
            <a href="mailto:contact@ecosystemeimmo.fr" class="hover:text-navy-900 transition-colors">contact@ecosystemeimmo.fr</a>
          </div>
        </div>
      </div>

    </div>

    <div class="mt-10 pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-slate-400">
      <span>&copy; 2026 Écosystème Immo &mdash; OCDM Agency</span>
      <div class="flex gap-4">
        <a href="/mentions-legales" class="hover:text-slate-600 transition-colors">Mentions légales</a>
        <a href="/cgu" class="hover:text-slate-600 transition-colors">CGU</a>
        <a href="/confidentialite" class="hover:text-slate-600 transition-colors">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>
