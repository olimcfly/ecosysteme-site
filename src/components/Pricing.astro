---
const plans = [
  {
    name: "Formule Estimateur",
    price: "27",
    unit: "€/mois",
    setup: "+ 197 € setup unique",
    features: [
      "Estimateur immobilier intégré à votre site",
      "Formulaire de capture vendeurs",
      "Hébergement et maintenance",
    ],
    forWho: "Pour démarrer par la capture d'estimations.",
    cta: "Choisir cette formule",
    ctaHref: "#verifier",
    highlight: false,
  },
  {
    name: "Formule Mensuelle",
    badge: "RECOMMANDÉE",
    price: "97",
    unit: "€/mois",
    setup: "+ 497 € setup · 3 mois prépayés",
    features: [
      "Site immobilier local à votre nom",
      "Pages secteurs et quartiers",
      "Google Business Profile",
      "Estimateur et formulaire vendeur",
      "CRM et suivi prospects",
      "Automatisations et relances IA",
      "Contenu SEO mensuel",
      "Exclusivité territoriale",
    ],
    forWho: "Système complet sans engagement annuel.",
    cta: "Vérifier si ma ville est disponible",
    ctaHref: "#verifier",
    highlight: true,
  },
  {
    name: "Formule Annuelle",
    badge: "MEILLEURE VALEUR",
    price: "897",
    unit: "€/an",
    setup: "Setup offert · ≈ 74 €/mois · Économisez 267 €",
    features: [
      "Tout le Mensuel, plus :",
      "Setup offert (497 € économisés)",
      "Exclusivité territoriale renforcée",
      "Priorité sur les villes à forte demande",
    ],
    forWho: "Pour sécuriser son territoire durablement.",
    cta: "Sécuriser mon territoire",
    ctaHref: "#verifier",
    highlight: false,
  },
];
---
<section class="pricing" id="tarifs">
  <div class="container">
    <div class="intro">
      <h2>Sécurisez votre territoire</h2>
      <p>Un système. Un territoire. Un conseiller.<br>Chaque formule inclut l'exclusivité sur votre secteur.</p>
    </div>

    <div class="plans">
      {plans.map(plan => (
        <div class={`plan${plan.highlight ? ' plan--highlight' : ''}`}>
          {plan.badge && <div class="badge">{plan.badge}</div>}
          <div class="plan-name">{plan.name}</div>
          <div class="plan-price">
            <span class="amount">{plan.price}</span>
            <span class="unit">{plan.unit}</span>
          </div>
          <div class="plan-setup">{plan.setup}</div>
          <ul class="plan-features">
            {plan.features.map(f => <li>{f}</li>)}
          </ul>
          <p class="plan-for">{plan.forWho}</p>
          <a href={plan.ctaHref} class={`plan-cta${plan.highlight ? ' plan-cta--primary' : ' plan-cta--outline'}`}>
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="exclusive">
      <div class="exclusive-body">
        <div class="exclusive-text">
          <h3>Exclusivité Verrouillée</h3>
          <p>Verrou territorial à vie sur votre ville. Sans abonnement. Sans renouvellement. Votre territoire reste bloqué pour les concurrents, quelle que soit votre formule.</p>
        </div>
        <div class="exclusive-price-block">
          <span class="ex-amount">900 €</span>
          <span class="ex-unit">paiement unique</span>
        </div>
        <a href="#verifier" class="plan-cta plan-cta--outline exclusive-cta">Me renseigner sur cette option</a>
      </div>
    </div>

    <p class="reassurance">
      Vos données, votre domaine, votre site — vous repartez avec tout si vous partez.<br>
      Un seul conseiller par territoire. La disponibilité dépend de votre ville.
    </p>

    <div class="fondateur">
      <p><strong>Programme Fondateur — Places épuisées.</strong></p>
      <p>Les 5 premiers conseillers ont rejoint à 47&nbsp;€/mois à vie. Ces places sont fermées. Ce sont eux qui apparaissent dans les réalisations ci-dessous.</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: #f8fafc;
    padding: 96px 16px;
    border-top: 1px solid #e2e8f0;
  }

  .container { max-width: 1100px; margin: 0 auto; }

  .intro {
    text-align: center;
    margin-bottom: 56px;
  }

  h2 {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .intro p {
    font-size: 16px;
    color: #475569;
    line-height: 1.6;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
    align-items: start;
  }

  .plan {
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
  }

  .plan--highlight {
    border-color: #0f172a;
    box-shadow: 0 4px 24px rgba(15,23,42,0.08);
  }

  .badge {
    display: inline-block;
    background: #0f172a;
    color: #f8fafc;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 16px;
    align-self: flex-start;
  }

  .plan-name {
    font-size: 12px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 16px;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 4px;
  }

  .amount {
    font-size: 44px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .unit {
    font-size: 15px;
    color: #94a3b8;
    font-weight: 500;
  }

  .plan-setup {
    font-size: 13px;
    color: #94a3b8;
    margin-bottom: 28px;
    line-height: 1.4;
  }

  .plan-features {
    list-style: none;
    flex: 1;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .plan-features li {
    font-size: 14px;
    color: #334155;
    padding: 8px 0 8px 18px;
    border-bottom: 1px solid #f1f5f9;
    position: relative;
    line-height: 1.4;
  }

  .plan-features li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #cbd5e1;
    font-size: 12px;
  }

  .plan-for {
    font-size: 13px;
    color: #64748b;
    font-style: italic;
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .plan-cta {
    display: block;
    text-align: center;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s;
    margin-top: auto;
  }

  .plan-cta--primary {
    background: #0f172a;
    color: #f8fafc;
  }
  .plan-cta--primary:hover { opacity: 0.85; }

  .plan-cta--outline {
    background: transparent;
    color: #0f172a;
    border: 1.5px solid #cbd5e1;
  }
  .plan-cta--outline:hover { border-color: #0f172a; }

  /* Bloc exclusivité */
  .exclusive {
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 28px 32px;
    margin-bottom: 24px;
  }

  .exclusive-body {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .exclusive-text {
    flex: 1;
    min-width: 240px;
  }

  .exclusive h3 {
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .exclusive p {
    font-size: 14px;
    color: #475569;
    line-height: 1.6;
  }

  .exclusive-price-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  .ex-amount {
    font-size: 36px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .ex-unit {
    font-size: 13px;
    color: #64748b;
  }

  .exclusive-cta {
    flex-shrink: 0;
  }

  .reassurance {
    text-align: center;
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 24px;
    padding: 0 8px;
  }

  .fondateur {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 20px 24px;
    text-align: center;
  }

  .fondateur p {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
  }

  .fondateur p:first-child {
    color: #334155;
    margin-bottom: 6px;
  }

  @media (max-width: 900px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin-left: auto;
      margin-right: auto;
    }
    .pricing { padding: 72px 16px; }
    .exclusive-body {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>
